# Copy to .env and edit. Everything here is optional -- ResuMatch runs with
# none of it set, using the values in config.yaml.

# --- Path overrides -------------------------------------------------------
# Where resumatch.log is written. Default: the repo root.
#RESUMATCH_DATA_DIR=/var/lib/resumatch

# Directory holding config.yaml and .env. Default: the repo root.
#RESUMATCH_CONFIG_DIR=/etc/resumatch

# API base URL the Streamlit dashboard talks to.
# Default: http://localhost:8510 (docker-compose sets this to http://api:8510).
#RESUMATCH_API_URL=http://localhost:8510

# --- config.yaml overrides ------------------------------------------------
# Any setting in config.yaml can be overridden as RESUMATCH_<SECTION>__<KEY>
# (note the DOUBLE underscore between section and key). Naming a key that does
# not exist in config.yaml is an error at startup, not a silent no-op.

# Optional LLM for bullet-point rewrites (/api/v1/improve). Any
# OpenAI-compatible endpoint: llama-server, LM Studio, Ollama, vLLM.
# Every other endpoint works with this disabled.
#RESUMATCH_LLM__ENABLED=false
#RESUMATCH_LLM__BASE_URL=http://localhost:8080
#RESUMATCH_LLM__MODEL=qwen2.5-coder
#RESUMATCH_LLM__TIMEOUT_SECONDS=120

# API server
#RESUMATCH_API__HOST=0.0.0.0
#RESUMATCH_API__PORT=8510
#RESUMATCH_API__MAX_UPLOAD_MB=10
#RESUMATCH_API__CORS_ORIGINS=http://localhost:8511,http://localhost:3000

# Scoring thresholds
#RESUMATCH_SCORING__ZONES__GREEN=85
#RESUMATCH_SCORING__ZONES__YELLOW=50

# Dashboard
#RESUMATCH_DASHBOARD__PORT=8511
