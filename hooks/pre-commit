#!/usr/bin/env bash
# ResuMatch pre-commit hook: syntax check + pyflakes + secret scan
set -euo pipefail

echo "Running pre-commit checks..."

# 1. Python syntax check
echo "  [1/3] Syntax check..."
find resumatch tests -name "*.py" -exec python -c "
import py_compile, sys
try:
    py_compile.compile(sys.argv[1], doraise=True)
except py_compile.PyCompileError as e:
    print(f'SYNTAX ERROR: {e}')
    sys.exit(1)
" {} \;

# 2. Pyflakes (undefined names)
echo "  [2/3] Pyflakes..."
if command -v pyflakes &> /dev/null; then
    pyflakes resumatch/ tests/ || { echo "Pyflakes found issues."; exit 1; }
else
    echo "  pyflakes not installed, skipping."
fi

# 3. Secret scan (basic)
echo "  [3/3] Secret scan..."
if grep -rn "sk-ant-\|PRIVATE KEY\|password\s*=" resumatch/ tests/ --include="*.py" 2>/dev/null; then
    echo "POTENTIAL SECRET DETECTED! Review the above matches."
    exit 1
fi

echo "All pre-commit checks passed."
